{
  "name": "was-vscode",
  "displayName": "WebSphere Controller",
  "description": "VS Code extension that lets you control Websphere via the UI",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:websphere.refreshStatus",
    "onStartupFinished"
  ],
  "icon": "resources/websphere.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
        {
            "command": "websphere.startServer",
            "title": "Start server"
        },
        {
            "command": "websphere.stopServer",
            "title": "Stop server"
        },
        {
            "command": "websphere.refreshStatus",
            "title": "Refresh Server Status"
        },
        {
            "command": "websphere.configureLooseEar",
            "title": "Configure Loose EAR Deployment"
        },
        {
            "command": "websphere.removeModule",
            "title": "some title"
        }
    ],
    "viewsContainers": {
        "activitybar": [
            {
                "id": "websphere",
                "title": "WebSphere",
                "icon": "resources/websphere.png"
            }
        ]
    },
    "views": {
        "explorer": [
            {
                "id": "websphereLooseEar",
                "name": "WebSphere",
                "icon": "resources/websphere.png"
            }
        ]
    },
    "menus": {
        "view/item/context": [
            {
                "command": "websphere.configureLooseEar",
                "when": "view == websphereLooseEar && viewItem == server",
                "group": "navigation"
            },
            {
                "command": "websphere.startServer",
                "when": "view == websphereLooseEar && viewItem == server",
                "group": "navigation"
            },
            {
                "command": "websphere.stopServer",
                "when": "view == websphereLooseEar && viewItem == server",
                "group": "navigation"
            },
            {
                "command": "websphere.removeModule",
                "when": "view == websphereLooseEar && viewItem == module",
                "group": "navigation"
            }
        ]
    },
    "configuration": {
      "title": "WebSphere",
      "properties": {
        "websphere.agent.executablePath": {
          "type": "string",
          "markdownDescription": "Absolute path to the WAS monitoring server",
          "default": "",
          "scope": "machine"
        },
        "websphere.log.level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "markdownDescription": "Minimum client log level for the extension (internal logging)"
        },
        "websphere.request.timeoutMs": {
          "type": "number",
          "default": 10000,
          "markdownDescription": "Default timeout (ms) for agent requests."
        },
        "websphere.agent.transport": {
            "type": "string",
            "enum": ["stdio", "tcp"],
            "default": "tcp"
        },
        "websphere.agent.host": {
            "type": "string",
            "default": "localhost"
        },
        "websphere.agent.port": {
            "type": "number",
            "default": 9999
        },
        "websphere.server.javaPath": {
            "type": "string",
            "default": "java",
            "description": "Path to the Java executable used to start WebSphere."
        },
        "websphere.server.home": {
            "type": "string",
            "default": "",
            "description": "WebSphere installation home directory."
        },
        "websphere.server.logFile": {
            "type": "string",
            "default": "",
            "description": "Full path to the WebSphere log file"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint 'src/**/*.ts'",
    "package": "vsce package",
    "prepare": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.5.0",
    "typescript": "^5.4.0",
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  }
}
